{
  "name": "@cyguin/banner",
  "version": "0.1.7",
  "description": "Drop-in in-app banner system for self-hosted Next.js apps",
  "license": "MIT",
  "keywords": [
    "cyguin",
    "banner",
    "announcement",
    "nextjs",
    "self-hosted"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/cyguin/banner"
  },
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./next": {
      "types": "./dist/next.d.ts",
      "default": "./dist/next.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    },
    "./adapters/sqlite": {
      "types": "./dist/adapters/sqlite.d.ts",
      "default": "./dist/adapters/sqlite.js"
    },
    "./adapters/postgres": {
      "types": "./dist/adapters/postgres.d.ts",
      "default": "./dist/adapters/postgres.js"
    }
  },
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "next": ">=14",
    "react": ">=18",
    "better-sqlite3": ">=11",
    "postgres": ">=3"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "pack:check": "npm pack --dry-run",
    "prepublishOnly": "npm run build && npm run pack:check"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "next": "^15.5.15",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "tsup": "^8.3.0",
    "typescript": "^5.5.0"
  },
  "author": {
    "name": "cyguin LLC",
    "url": "https://cyguin.com"
  }
}
